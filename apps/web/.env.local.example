# Supabase (required for cloud sync / sign-in)
# Copy to apps/web/.env.local for local Tier 2. On Vercel, set the same names in Project Settings.
# The app runs without these (local-only / Tier 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Vercel cron keep-alive for free-tier Supabase (see docs/self-hosting.md)
# CRON_SECRET=
